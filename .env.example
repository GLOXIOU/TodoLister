PORT=3000

# MySQL connection (remote server supported, local SQL is optional)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password_here
DB_NAME=todolister

# IP Whitelist (comma-separated, supports CIDR)
# Anyone NOT in this list is blocked from the entire app
ALLOWED_IPS=127.0.0.1,::1

# Reverse proxy (nginx, Caddy, Traefik...). Leave EMPTY when clients connect directly:
# X-Forwarded-For is then ignored, so nobody can fake a whitelisted IP.
# Behind a proxy on the same machine use "loopback"; otherwise the proxy IP/CIDR or a hop count.
TRUST_PROXY=

# Session secret — change this!
SESSION_SECRET=change_me_to_something_very_random_and_long
